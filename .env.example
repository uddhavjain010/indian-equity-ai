# Data Provider Selection (options: default, yfinance, upstox)
YFINANCE_PROVIDER=default

# Upstox V3 Market Data Feed Configuration
# Refer to Upstox API documentation: https://upstox.com/developer/api-documentation/v3/get-market-data-feed/
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_ACCESS_TOKEN=
UPSTOX_REDIRECT_URI=https://127.0.0.1:5000/

# Model and Dashboard Settings
LOG_LEVEL=INFO
DEFAULT_LOOKBACK=60
